<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Todo.Models"
             xmlns:viewModels="clr-namespace:Todo.ViewModels"
             x:Class="Todo.MainPage"
             x:Name="TodoPage"
             x:DataType="viewModels:TodoViewModel"
             Title="Список задач"
             BackgroundColor="#F1F4F8">
    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="#233047" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="#315CCB" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="6" />
            <Style.Triggers>
                <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                    <Setter Property="BackgroundColor" Value="#DCE2EC" />
                    <Setter Property="TextColor" Value="#657187" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>

    <Grid Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <Border BackgroundColor="#EAF0FF" Stroke="#B8C9EE"
                StrokeShape="RoundRectangle 12" Padding="14">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                <Label Text="Новая задача" FontSize="18" FontAttributes="Bold" />

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Placeholder="Заголовок задачи"
                           Text="{Binding NewTitle, Mode=TwoWay}"
                           TextColor="Black" PlaceholderColor="Gray"
                           BackgroundColor="White" />
                    <Button Grid.Column="1" Text="Добавить"
                            Command="{Binding AddTaskCommand}" />
                </Grid>

                <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="Категория" VerticalOptions="Center" />
                    <Picker Grid.Column="1" Title="Категория"
                            ItemsSource="{Binding Categories}"
                            SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                            TextColor="Black" TitleColor="Gray" BackgroundColor="White" />
                </Grid>

                <VerticalStackLayout Grid.Row="3" Spacing="2">
                    <Label Text="Добавить как основную задачу или как подзадачу к:" FontSize="13" />
                    <Picker Title="Родительская задача"
                            ItemsSource="{Binding ParentOptions}"
                            ItemDisplayBinding="{Binding Title, x:DataType=models:TodoItem}"
                            SelectedItem="{Binding SelectedParent, Mode=TwoWay}"
                            TextColor="Black" TitleColor="Gray" BackgroundColor="White" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <Label Grid.Row="1" Text="Мои задачи" FontSize="18" FontAttributes="Bold" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding Tasks}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Пока нет задач — добавь первую выше" TextColor="#657187"
                       HorizontalTextAlignment="Center" Margin="0,24" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TodoItem">
                    <!-- У подзадач отступ слева. У основных задач ParentId равен 0. -->
                    <Border Padding="10" Margin="24,0,0,8"
                            BackgroundColor="White" Stroke="#D2DAE6"
                            StrokeShape="RoundRectangle 10">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding ParentId}" Value="0">
                                <Setter Property="Margin" Value="0,0,0,8" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsCompleted}" Value="True">
                                <Setter Property="BackgroundColor" Value="#F0F8F3" />
                                <Setter Property="Stroke" Value="#BCD9C6" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">

                            <Button Text="○" WidthRequest="44" Padding="0" FontSize="22"
                                    BackgroundColor="#EAF0FF" TextColor="#315CCB"
                                    VerticalOptions="Center"
                                    SemanticProperties.Description="Отметить или отменить выполнение"
                                    Command="{Binding BindingContext.ToggleTaskCommand, Source={x:Reference TodoPage}}"
                                    CommandParameter="{Binding .}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsCompleted}" Value="True">
                                        <Setter Property="Text" Value="✓" />
                                        <Setter Property="BackgroundColor" Value="#26734D" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="6">
                                <Label Text="{Binding Title}" FontSize="18">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                            <Setter Property="TextColor" Value="Gray" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding Category}" FontSize="12"
                                       TextColor="#46556C" BackgroundColor="#E8EDF4"
                                       Padding="6,3" HorizontalOptions="Start">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Category}" Value="Покупки">
                                            <Setter Property="BackgroundColor" Value="#DCEBFF" />
                                            <Setter Property="TextColor" Value="#234E88" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Category}" Value="Учёба">
                                            <Setter Property="BackgroundColor" Value="#EDE3FF" />
                                            <Setter Property="TextColor" Value="#644193" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Category}" Value="Дом">
                                            <Setter Property="BackgroundColor" Value="#FFF0CD" />
                                            <Setter Property="TextColor" Value="#795614" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Category}" Value="Работа">
                                            <Setter Property="BackgroundColor" Value="#DDF2E7" />
                                            <Setter Property="TextColor" Value="#246343" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>

                            <Button Grid.Column="2" Text="Удалить" FontSize="12" Padding="8"
                                    BackgroundColor="#FCE8E8" TextColor="#A33131"
                                    VerticalOptions="Center"
                                    Command="{Binding BindingContext.DeleteTaskCommand, Source={x:Reference TodoPage}}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
